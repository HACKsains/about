# ==============================================================================
# .htaccess — Syahriel Andika CV & 3D Portfolio (about.ilmuna.my.id)
# Universal & Safe for both Laragon (Localhost) and cPanel/LiteSpeed Hosting
# NOTE: No hardcoded AddHandler/alt-php directives (prevents PHP file download)
# ==============================================================================

DirectoryIndex index.php
Options -Indexes

# ------------------------------------------------------------------------------
# 1. PROTEKSI FILE & FOLDER SENSITIF
# ------------------------------------------------------------------------------
<FilesMatch "(^\.ht|\.env|\.git|\.user\.ini|php\.ini|error_log|README\.md|about\.zip|\.sql|\.bak|\.swp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Blokir akses langsung ke folder internal (config, data, includes)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|data|includes|dokumentasi)/ - [F,L,NC]
</IfModule>

# ------------------------------------------------------------------------------
# 2. HTTP SECURITY HEADERS
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
FileETag None

# ------------------------------------------------------------------------------
# 3. KOMPRESI GZIP & CACHING ASET STATIS
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
</IfModule>

<IfModule Litespeed>
  SetEnv noabort 1
</IfModule>
